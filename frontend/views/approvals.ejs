<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: 'Approvals', apiBase }) %>
<body>
  <div style="display:flex;height:100vh;overflow:hidden;">
    <%- include('partials/sidebar', { page }) %>

    <main style="flex:1;overflow-y:auto;display:flex;flex-direction:column;">
      <div style="padding:20px 32px;border-bottom:1px solid #0A5A7C;display:flex;align-items:center;justify-content:space-between;flex-shrink:0;background:#011F30;position:sticky;top:0;z-index:10;">
        <h1 style="font-family:'DM Serif Display',serif;font-size:22px;color:#FCF3E3;margin:0;">Approvals</h1>
        <div style="display:flex;align-items:center;gap:10px;">
          <select id="filter-status" class="input-field" style="width:160px;" onchange="loadApprovals()">
            <option value="pending">Pending</option>
            <option value="">All</option>
          </select>
        </div>
      </div>

      <div style="flex:1;padding:24px 32px;">
        <div class="section-card" style="overflow:hidden;">
          <div style="overflow-x:auto;">
            <table style="width:100%;border-collapse:collapse;">
              <thead>
                <tr style="border-bottom:1px solid #0A5A7C;">
                  <th style="padding:12px 20px;text-align:left;font-size:11px;color:#8DD3CE;font-family:'JetBrains Mono',monospace;font-weight:400;text-transform:uppercase;letter-spacing:0.06em;">Task</th>
                  <th style="padding:12px 16px;text-align:left;font-size:11px;color:#8DD3CE;font-family:'JetBrains Mono',monospace;font-weight:400;text-transform:uppercase;letter-spacing:0.06em;">Agent</th>
                  <th style="padding:12px 16px;text-align:left;font-size:11px;color:#8DD3CE;font-family:'JetBrains Mono',monospace;font-weight:400;text-transform:uppercase;letter-spacing:0.06em;">Command Preview</th>
                  <th style="padding:12px 16px;text-align:left;font-size:11px;color:#8DD3CE;font-family:'JetBrains Mono',monospace;font-weight:400;text-transform:uppercase;letter-spacing:0.06em;">Type</th>
                  <th style="padding:12px 16px;text-align:left;font-size:11px;color:#8DD3CE;font-family:'JetBrains Mono',monospace;font-weight:400;text-transform:uppercase;letter-spacing:0.06em;">Level</th>
                  <th style="padding:12px 16px;text-align:left;font-size:11px;color:#8DD3CE;font-family:'JetBrains Mono',monospace;font-weight:400;text-transform:uppercase;letter-spacing:0.06em;">Status</th>
                  <th style="padding:12px 16px;text-align:left;font-size:11px;color:#8DD3CE;font-family:'JetBrains Mono',monospace;font-weight:400;text-transform:uppercase;letter-spacing:0.06em;">Expires</th>
                  <th style="padding:12px 20px;text-align:right;font-size:11px;color:#8DD3CE;font-family:'JetBrains Mono',monospace;font-weight:400;text-transform:uppercase;letter-spacing:0.06em;"></th>
                </tr>
              </thead>
              <tbody id="approvals-body">
                <tr><td colspan="8" style="padding:40px;text-align:center;color:#8DD3CE;font-size:13px;">Loading…</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </main>
  </div>

  <!-- Resolve Modal -->
  <div id="resolve-modal" class="modal-overlay" style="display:none;">
    <div class="modal-box">
      <div style="display:flex;align-items:start;justify-content:space-between;margin-bottom:20px;">
        <div>
          <h3 style="font-family:'DM Serif Display',serif;font-size:18px;color:#FCF3E3;margin:0 0 4px;">Resolve Approval</h3>
          <p style="font-size:12px;color:#8DD3CE;margin:0;" id="modal-agent-name"></p>
        </div>
        <button onclick="closeModal()" style="background:none;border:none;cursor:pointer;color:#8DD3CE;font-size:20px;line-height:1;padding:0;" onmouseover="this.style.color='#FCF3E3'" onmouseout="this.style.color='#8DD3CE'">×</button>
      </div>

      <div style="margin-bottom:20px;">
        <p style="font-size:11px;color:#8DD3CE;font-family:'JetBrains Mono',monospace;text-transform:uppercase;letter-spacing:0.08em;margin:0 0 8px;">Command Preview</p>
        <div class="code-block" id="modal-command" style="max-height:120px;overflow-y:auto;"></div>
      </div>

      <div id="modal-context-block" style="margin-bottom:20px;display:none;">
        <p style="font-size:11px;color:#8DD3CE;font-family:'JetBrains Mono',monospace;text-transform:uppercase;letter-spacing:0.08em;margin:0 0 8px;">Context</p>
        <div style="font-size:12px;color:#FCF3E3;line-height:1.6;" id="modal-context"></div>
      </div>

      <div style="margin-bottom:24px;">
        <label style="display:block;font-size:11px;color:#8DD3CE;font-family:'JetBrains Mono',monospace;text-transform:uppercase;letter-spacing:0.08em;margin-bottom:8px;">Resolution Note <span style="opacity:.5;">(optional)</span></label>
        <textarea id="modal-note" class="input-field" rows="3" placeholder="Add a note for the audit log…" style="resize:vertical;"></textarea>
      </div>

      <div style="display:flex;gap:10px;justify-content:flex-end;">
        <button onclick="closeModal()" class="btn-ghost">Cancel</button>
        <button onclick="resolveApproval('denied')" class="btn-danger" id="deny-btn">Deny</button>
        <button onclick="resolveApproval('approved')" class="btn-primary" id="approve-btn">Approve</button>
      </div>
    </div>
  </div>

  <script src="/js/api.js"></script>
  <script src="/js/mock-data.js"></script>
  <script src="/js/approvals.js"></script>
</body>
</html>
