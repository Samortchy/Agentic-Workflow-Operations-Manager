<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: 'Employees', apiBase }) %>
<body>
  <div style="display:flex;height:100vh;overflow:hidden;">
    <%- include('partials/sidebar', { page }) %>

    <main style="flex:1;overflow-y:auto;display:flex;flex-direction:column;">
      <div style="padding:20px 32px;border-bottom:1px solid #0A5A7C;display:flex;align-items:center;justify-content:space-between;flex-shrink:0;background:#011F30;position:sticky;top:0;z-index:10;">
        <h1 style="font-family:'DM Serif Display',serif;font-size:22px;color:#FCF3E3;margin:0;">Employees</h1>
        <button onclick="openAddModal()" class="btn-primary" id="add-btn" style="display:none;">Add Employee</button>
      </div>

      <!-- Filters -->
      <div style="padding:16px 32px;border-bottom:1px solid #0A5A7C;display:flex;align-items:center;gap:12px;flex-shrink:0;background:#011F30;">
        <select id="filter-dept" class="input-field" style="width:150px;" onchange="loadEmployees()">
          <option value="">All departments</option>
          <option value="IT">IT</option>
          <option value="HR">HR</option>
          <option value="Finance">Finance</option>
          <option value="cross-dept">Cross-dept</option>
          <option value="Other">Other</option>
        </select>
        <select id="filter-active" class="input-field" style="width:130px;" onchange="loadEmployees()">
          <option value="true">Active only</option>
          <option value="">All</option>
          <option value="false">Inactive</option>
        </select>
      </div>

      <div style="flex:1;padding:24px 32px;">
        <p id="pw-demo-note" style="display:none;font-size:11px;color:#8DD3CE;margin:0 0 12px;font-family:'JetBrains Mono',monospace;letter-spacing:0.02em;">
          ⚠ Temp passwords shown below are a <span style="color:#F4A258;">demo convenience</span> — not stored securely and not a permanent feature.
        </p>
        <div class="section-card" style="overflow:hidden;">
          <table style="width:100%;border-collapse:collapse;">
            <thead>
              <tr style="border-bottom:1px solid #0A5A7C;">
                <th style="padding:12px 20px;text-align:left;font-size:11px;color:#8DD3CE;font-family:'JetBrains Mono',monospace;font-weight:400;text-transform:uppercase;letter-spacing:0.06em;">Name</th>
                <th style="padding:12px 16px;text-align:left;font-size:11px;color:#8DD3CE;font-family:'JetBrains Mono',monospace;font-weight:400;text-transform:uppercase;letter-spacing:0.06em;">Email</th>
                <th style="padding:12px 16px;text-align:left;font-size:11px;color:#8DD3CE;font-family:'JetBrains Mono',monospace;font-weight:400;text-transform:uppercase;letter-spacing:0.06em;">Role</th>
                <th style="padding:12px 16px;text-align:left;font-size:11px;color:#8DD3CE;font-family:'JetBrains Mono',monospace;font-weight:400;text-transform:uppercase;letter-spacing:0.06em;">Department</th>
                <th style="padding:12px 16px;text-align:left;font-size:11px;color:#8DD3CE;font-family:'JetBrains Mono',monospace;font-weight:400;text-transform:uppercase;letter-spacing:0.06em;">Access</th>
                <th style="padding:12px 16px;text-align:left;font-size:11px;color:#8DD3CE;font-family:'JetBrains Mono',monospace;font-weight:400;text-transform:uppercase;letter-spacing:0.06em;">Status</th>
                <th style="padding:12px 20px;text-align:right;font-size:11px;color:#8DD3CE;font-family:'JetBrains Mono',monospace;font-weight:400;text-transform:uppercase;letter-spacing:0.06em;"></th>
              </tr>
            </thead>
            <tbody id="employees-body">
              <tr><td colspan="7" style="padding:40px;text-align:center;color:#8DD3CE;font-size:13px;">Loading…</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>

  <!-- Add Employee Modal -->
  <div id="add-modal" class="modal-overlay" style="display:none;">
    <div class="modal-box">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;">
        <h3 style="font-family:'DM Serif Display',serif;font-size:18px;color:#FCF3E3;margin:0;">Add Employee</h3>
        <button onclick="closeAddModal()" style="background:none;border:none;cursor:pointer;color:#8DD3CE;font-size:20px;line-height:1;padding:0;">×</button>
      </div>

      <div id="add-error" style="display:none;background:rgba(224,82,82,0.1);border:1px solid #E05252;border-radius:4px;padding:10px 14px;font-size:13px;color:#E05252;margin-bottom:16px;"></div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;">
        <div>
          <label style="display:block;font-size:12px;color:#8DD3CE;margin-bottom:6px;">Full Name</label>
          <input type="text" id="add-name" class="input-field" placeholder="Jane Smith" />
        </div>
        <div>
          <label style="display:block;font-size:12px;color:#8DD3CE;margin-bottom:6px;">Work Email</label>
          <input type="email" id="add-email" class="input-field" placeholder="jane@company.com" />
        </div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;">
        <div>
          <label style="display:block;font-size:12px;color:#8DD3CE;margin-bottom:6px;">Role / Title</label>
          <input type="text" id="add-role" class="input-field" placeholder="IT Support" />
        </div>
        <div>
          <label style="display:block;font-size:12px;color:#8DD3CE;margin-bottom:6px;">Department</label>
          <select id="add-dept" class="input-field">
            <option value="IT">IT</option>
            <option value="HR">HR</option>
            <option value="Finance">Finance</option>
            <option value="cross-dept">Cross-dept</option>
            <option value="Other">Other</option>
          </select>
        </div>
      </div>
      <div style="margin-bottom:24px;">
        <label style="display:block;font-size:12px;color:#8DD3CE;margin-bottom:6px;">Access Level</label>
        <select id="add-level" class="input-field">
          <option value="1">1 — Employee</option>
          <option value="2">2 — Senior</option>
          <option value="3">3 — Manager</option>
          <option value="4">4 — Executive</option>
        </select>
      </div>

      <div style="display:flex;gap:10px;justify-content:flex-end;">
        <button onclick="closeAddModal()" class="btn-ghost">Cancel</button>
        <button onclick="submitAdd()" class="btn-primary" id="add-submit-btn">Add Employee</button>
      </div>
    </div>
  </div>

  <script src="/js/api.js"></script>
  <script src="/js/mock-data.js"></script>
  <script src="/js/employees.js"></script>
</body>
</html>
