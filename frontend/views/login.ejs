<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: 'Sign in', apiBase }) %>
<body>
  <div style="min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px;">
    <div style="width:100%;max-width:400px;">

      <!-- Brand -->
      <div style="text-align:center;margin-bottom:40px;">
        <h1 style="font-family:'DM Serif Display',serif;font-size:32px;color:#FCF3E3;margin:0 0 6px;">AWOM</h1>
        <p style="font-size:12px;color:#8DD3CE;font-family:'JetBrains Mono',monospace;letter-spacing:0.1em;text-transform:uppercase;margin:0;">Automated Workflow Operations</p>
      </div>

      <!-- Card -->
      <div class="section-card" style="padding:32px;">
        <h2 style="font-size:18px;font-weight:500;color:#FCF3E3;margin:0 0 6px;">Sign in to your workspace</h2>
        <p style="font-size:13px;color:#8DD3CE;margin:0 0 28px;">Enter your credentials to continue</p>

        <div id="error-msg" style="display:none;background:rgba(224,82,82,0.1);border:1px solid #E05252;border-radius:4px;padding:10px 14px;font-size:13px;color:#E05252;margin-bottom:20px;"></div>

        <form id="login-form">
          <div style="margin-bottom:16px;">
            <label style="display:block;font-size:12px;color:#8DD3CE;font-family:'JetBrains Mono',monospace;text-transform:uppercase;letter-spacing:0.08em;margin-bottom:6px;">Email</label>
            <input type="email" id="email" class="input-field" placeholder="you@company.com" required autocomplete="email" />
          </div>
          <div style="margin-bottom:24px;">
            <label style="display:block;font-size:12px;color:#8DD3CE;font-family:'JetBrains Mono',monospace;text-transform:uppercase;letter-spacing:0.08em;margin-bottom:6px;">Password</label>
            <input type="password" id="password" class="input-field" placeholder="••••••••" required autocomplete="current-password" />
          </div>
          <button type="submit" id="submit-btn" class="btn-primary" style="width:100%;">Sign in</button>
        </form>
      </div>

      <!-- Preview mode -->
      <div style="margin-top:16px;padding-top:16px;border-top:1px solid #0A5A7C;text-align:center;">
        <button onclick="enterPreview()" style="font-size:12px;color:#8DD3CE;background:none;border:none;cursor:pointer;font-family:'JetBrains Mono',monospace;letter-spacing:0.04em;padding:0;" onmouseover="this.style.color='#F4A258'" onmouseout="this.style.color='#8DD3CE'">
          Preview UI without backend →
        </button>
      </div>

      <p style="text-align:center;font-size:13px;color:#8DD3CE;margin-top:20px;">
        No account?
        <a href="/register" style="color:#F4A258;text-decoration:none;font-weight:500;">Set up your workspace</a>
      </p>
    </div>
  </div>

  <script src="/js/api.js"></script>
  <script src="/js/mock-data.js"></script>
  <script>
    if (Auth.isLoggedIn()) window.location.href = '/dashboard';

    function enterPreview() {
      localStorage.setItem('awom_demo', 'true');
      Auth.setTokens('demo-token', 'demo-refresh');
      Auth.setEmployee({
        employee_id: 'demo-emp-1',
        name: 'Alex Rivera',
        email: 'alex@acme-corp.com',
        role: 'Operations Manager',
        department: 'cross-dept',
        access_level: 4,
        is_active: true,
      });
      window.location.href = '/dashboard';
    }

    document.getElementById('login-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('submit-btn');
      const errEl = document.getElementById('error-msg');
      btn.disabled = true;
      btn.textContent = 'Signing in…';
      errEl.style.display = 'none';

      const email = document.getElementById('email').value.trim();
      const password = document.getElementById('password').value;

      try {
        const data = await fetch(`${window.API_BASE}/api/auth/login`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password }),
        }).then(r => r.json().then(d => ({ ok: r.ok, ...d })));

        if (!data.ok) {
          errEl.textContent = data.error || 'Invalid email or password.';
          errEl.style.display = 'block';
          btn.disabled = false;
          btn.textContent = 'Sign in';
          return;
        }

        // Valid Supabase auth is NOT enough — the account must also be linked to an
        // active employee profile. Verify with the token before persisting the session.
        let me = null;
        try {
          const empRes = await fetch(`${window.API_BASE}/api/employees`, {
            headers: { Authorization: `Bearer ${data.access_token}` },
          }).then(r => r.json());
          const employees = Array.isArray(empRes) ? empRes : (empRes.employees || []);
          me = employees.find(e => e.email === email) || null;
        } catch {}

        if (!me) {
          // Authenticated, but no employee profile → not authorized to enter.
          Auth.clear();
          errEl.textContent = 'No active employee profile is linked to this account. Contact your administrator.';
          errEl.style.display = 'block';
          btn.disabled = false;
          btn.textContent = 'Sign in';
          return;
        }

        Auth.setTokens(data.access_token, data.refresh_token);
        if (data.user) Auth.setUser(data.user);
        Auth.setEmployee(me);
        window.location.href = '/dashboard';
      } catch (err) {
        errEl.textContent = 'Could not reach server. Is the backend running?';
        errEl.style.display = 'block';
        btn.disabled = false;
        btn.textContent = 'Sign in';
      }
    });
  </script>
</body>
</html>
