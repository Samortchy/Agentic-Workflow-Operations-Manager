<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: 'Schedule', apiBase }) %>
<body>
  <div style="display:flex;height:100vh;overflow:hidden;">
    <%- include('partials/sidebar', { page }) %>

    <main style="flex:1;overflow-y:auto;display:flex;flex-direction:column;">
      <div style="padding:20px 32px;border-bottom:1px solid #0A5A7C;display:flex;align-items:center;justify-content:space-between;flex-shrink:0;background:#011F30;position:sticky;top:0;z-index:10;">
        <h1 style="font-family:'DM Serif Display',serif;font-size:22px;color:#FCF3E3;margin:0;">Schedule</h1>
        <button onclick="loadMeetings()" class="btn-ghost">Refresh</button>
      </div>

      <!-- Filters -->
      <div style="padding:16px 32px;border-bottom:1px solid #0A5A7C;display:flex;align-items:center;gap:12px;flex-shrink:0;background:#011F30;">
        <select id="filter-status" class="input-field" style="width:160px;" onchange="loadMeetings()">
          <option value="">All meetings</option>
          <option value="confirmed">Confirmed</option>
          <option value="proposed">Proposed</option>
          <option value="cancelled">Cancelled</option>
        </select>
      </div>

      <!-- Timeline -->
      <div id="timeline" style="flex:1;padding:24px 32px;">
        <div style="padding:40px;text-align:center;color:#8DD3CE;font-size:13px;">Loading…</div>
      </div>
    </main>
  </div>

  <!-- Meeting detail modal (filled by JS) -->
  <div id="meeting-modal" class="modal-overlay" style="display:none;">
    <div class="modal-box" id="meeting-modal-box"></div>
  </div>

  <script src="/js/api.js"></script>
  <script src="/js/meetings.js"></script>
</body>
</html>
