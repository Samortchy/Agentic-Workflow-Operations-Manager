<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: 'Tasks', apiBase }) %>
<body>
  <div style="display:flex;height:100vh;overflow:hidden;">
    <%- include('partials/sidebar', { page }) %>

    <main style="flex:1;overflow-y:auto;display:flex;flex-direction:column;">
      <div style="padding:20px 32px;border-bottom:1px solid #0A5A7C;display:flex;align-items:center;justify-content:space-between;flex-shrink:0;background:#011F30;position:sticky;top:0;z-index:10;">
        <h1 style="font-family:'DM Serif Display',serif;font-size:22px;color:#FCF3E3;margin:0;">Tasks</h1>
        <span style="font-size:12px;color:#8DD3CE;font-family:'JetBrains Mono',monospace;" id="task-count"></span>
      </div>

      <!-- Filters -->
      <div style="padding:16px 32px;border-bottom:1px solid #0A5A7C;display:flex;align-items:center;gap:12px;flex-shrink:0;background:#011F30;">
        <select id="filter-status" class="input-field" style="width:160px;">
          <option value="">All statuses</option>
          <option value="queued">Queued</option>
          <option value="in_progress">In Progress</option>
          <option value="completed">Completed</option>
          <option value="pending_human_review">Needs Review</option>
          <option value="approval_pending">Approval Pending</option>
          <option value="escalated">Escalated</option>
          <option value="failed">Failed</option>
          <option value="paused">Paused</option>
        </select>
        <select id="filter-dept" class="input-field" style="width:140px;">
          <option value="">All departments</option>
          <option value="IT">IT</option>
          <option value="HR">HR</option>
          <option value="Finance">Finance</option>
          <option value="cross-dept">Cross-dept</option>
          <option value="Other">Other</option>
        </select>
        <select id="filter-priority" class="input-field" style="width:140px;">
          <option value="">All priorities</option>
          <option value="1">Low</option>
          <option value="2">Medium</option>
          <option value="3">High</option>
          <option value="4">Critical</option>
        </select>
        <input type="text" id="filter-search" class="input-field" placeholder="Search task type or requester…" style="width:240px;" />
        <button onclick="applyFilters()" class="btn-ghost" style="flex-shrink:0;">Filter</button>
        <button onclick="clearFilters()" style="font-size:13px;color:#8DD3CE;background:none;border:none;cursor:pointer;font-family:'DM Sans',sans-serif;padding:0;flex-shrink:0;" onmouseover="this.style.color='#FCF3E3'" onmouseout="this.style.color='#8DD3CE'">Clear</button>
      </div>

      <div style="flex:1;padding:24px 32px;">
        <div class="section-card" style="overflow:hidden;">
          <div style="overflow-x:auto;">
            <table style="width:100%;border-collapse:collapse;">
              <thead>
                <tr style="border-bottom:1px solid #0A5A7C;">
                  <th style="padding:12px 20px;text-align:left;font-size:11px;color:#8DD3CE;font-family:'JetBrains Mono',monospace;font-weight:400;text-transform:uppercase;letter-spacing:0.06em;white-space:nowrap;">ID</th>
                  <th style="padding:12px 16px;text-align:left;font-size:11px;color:#8DD3CE;font-family:'JetBrains Mono',monospace;font-weight:400;text-transform:uppercase;letter-spacing:0.06em;">Task Type</th>
                  <th style="padding:12px 16px;text-align:left;font-size:11px;color:#8DD3CE;font-family:'JetBrains Mono',monospace;font-weight:400;text-transform:uppercase;letter-spacing:0.06em;">Status</th>
                  <th style="padding:12px 16px;text-align:left;font-size:11px;color:#8DD3CE;font-family:'JetBrains Mono',monospace;font-weight:400;text-transform:uppercase;letter-spacing:0.06em;">Priority</th>
                  <th style="padding:12px 16px;text-align:left;font-size:11px;color:#8DD3CE;font-family:'JetBrains Mono',monospace;font-weight:400;text-transform:uppercase;letter-spacing:0.06em;">Department</th>
                  <th style="padding:12px 16px;text-align:left;font-size:11px;color:#8DD3CE;font-family:'JetBrains Mono',monospace;font-weight:400;text-transform:uppercase;letter-spacing:0.06em;">Agent</th>
                  <th style="padding:12px 16px;text-align:left;font-size:11px;color:#8DD3CE;font-family:'JetBrains Mono',monospace;font-weight:400;text-transform:uppercase;letter-spacing:0.06em;">Requester</th>
                  <th style="padding:12px 20px;text-align:right;font-size:11px;color:#8DD3CE;font-family:'JetBrains Mono',monospace;font-weight:400;text-transform:uppercase;letter-spacing:0.06em;white-space:nowrap;">Created</th>
                </tr>
              </thead>
              <tbody id="tasks-body">
                <tr><td colspan="8" style="padding:40px;text-align:center;color:#8DD3CE;font-size:13px;">Loading…</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </main>
  </div>

  <script src="/js/api.js"></script>
  <script src="/js/mock-data.js"></script>
  <script src="/js/tasks.js"></script>
</body>
</html>
